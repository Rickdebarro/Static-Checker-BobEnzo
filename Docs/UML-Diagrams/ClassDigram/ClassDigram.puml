@startuml
skinparam classAttributeIconSize 0
skinparam theme simple

title Diagrama de Classes - Static Checker (Atualizado)

class Main_Script << (M, #FF7700) Script >> {
    + main() : void
}

class Alexico {
    - fonte : String
    - tabela_reservada : TabelaPalavrasReservadas
    - pos : int
    - linha : int
    - coluna : int
    + obter_proximo_token() : Token
    - _ler_identificador_ou_reservada() : Token
    - _ler_numero() : Token
    - _ler_string() : Token
    - _ler_char() : Token
    - _pular_comentario_bloco() : void
    - _pular_comentario_linha() : void
    - _caracter_a_frente(offset : int) : String
}

enum NivelEscopo {
    FORA
    PROGRAMA
    DECLARACOES
    FUNCOES
    CORPO_FUNCAO
}

class ControladorEscopo {
    - _pilha : List<NivelEscopo>
    - _aguardando_nome_funcao : boolean
    + atual() : NivelEscopo
    + abrir(nivel : NivelEscopo) : void
    + fechar() : void
    + esta_em(nivel : NivelEscopo) : boolean
    + codigo_para_identificador(codigo_token_anterior : String) : String
    + sinalizar_functype() : void
    + __str__() : String
}

class Token {
    - lexeme : String
    - codigo : String
    - linha : int
    - coluna : int
    - indice_tab : int
    - qtd_antes_trunc : int
    - qtd_depois_trunc : int
    + __str__() : String
}

class TabelaPalavrasReservadas {
    - _palavras : Map<String, String>
    + carregar_tabela_fixa() : void
    + contem(lexeme : String) : boolean
    + get_codigo(lexeme : String) : String
}

class TabelaSimbolos {
    - _simbolos : Map<String, Simbolo>
    - _contador : int
    + inserir_ou_atualizar(lexeme : String, codigo : String, qtd_antes_trunc : int, qtd_depois_trunc : int, linha : int) : int
    + buscar(lexeme : String) : Simbolo
    + buscar_por_indice(indice : int) : Simbolo
    + obter_todos() : List<Simbolo>
    + __len__() : int
}

class Simbolo {
    - indice : int
    - lexeme : String
    - codigo : String
    - qtd_antes_trunc : int
    - qtd_depois_trunc : int
    - tipo : String
    - linhas : List<Integer>
    + adicionar_linha(linha : int) : void
    + set_tipo(tipo : String) : void
    + __str__() : String
}

class GeradorRelatorioLEX {
    - codigo_equipe : String
    - componentes : List<Dict>
    + gerar(caminho_saida : String, nome_fonte : String, tokens : List<Token>) : void
}

class GeradorRelatorioTAB {
    - codigo_equipe : String
    - componentes : List<Dict>
    + gerar(caminho_saida : String, nome_fonte : String, tabela : TabelaSimbolos) : void
}

' Relacionamentos
Main_Script --> Alexico : "instancia e usa"
Main_Script --> TabelaSimbolos : "instancia e gerencia"
Main_Script --> TabelaPalavrasReservadas : "instancia"
Main_Script --> ControladorEscopo : "instancia e usa"
Main_Script --> GeradorRelatorioLEX : "instancia e usa"
Main_Script --> GeradorRelatorioTAB : "instancia e usa"

ControladorEscopo o-- NivelEscopo : "mantém na pilha"

Alexico --> Token : "cria"
Alexico --> TabelaPalavrasReservadas : "consulta"

TabelaSimbolos "1" *-- "many" Simbolo : "armazena e gerencia"

GeradorRelatorioLEX ..> Token : "formata dados"
GeradorRelatorioTAB ..> Simbolo : "formata dados"
GeradorRelatorioTAB ..> TabelaSimbolos : "obtém símbolos"

@enduml